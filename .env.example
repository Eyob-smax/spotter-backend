# Copy to .env and fill in. Never commit .env.

# --- Django ---
DEBUG=0
SECRET_KEY=change-me-to-a-long-random-string
# Public hostname(s) of the API, comma-separated (e.g. api.example.com)
ALLOWED_HOSTS=api.example.com
# Frontend origin(s) allowed to call the API (your Vercel URL), comma-separated
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
LOG_LEVEL=INFO
# Proxies in front of Django (the server's nginx = 1); used to find the real client IP for rate limits
NUM_PROXIES=1
# Loopback port the backend is published on; nginx proxies the API domain to it
BACKEND_PORT=8010

# --- Cache (set automatically by docker compose) ---
# REDIS_URL=redis://redis:6379/0

# --- Third-party APIs ---
TOMTOM_API_KEY=your-tomtom-key
# Optional paid Open-Meteo plan:
# OPEN_METEO_URL=https://customer-api.open-meteo.com/v1/forecast
# OPEN_METEO_API_KEY=

# --- Rate limits per client IP (optional) ---
# THROTTLE_ROUTES=12/min
# THROTTLE_ANALYSIS=30/min
# THROTTLE_HEATMAP=30/min
# THROTTLE_GEOCODE=120/min

